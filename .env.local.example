# 复制为 .env.local 后填写本机凭据。
MYSQL_USERNAME=collect_agent
MYSQL_PASSWORD=
MYSQL_ADMIN_USERNAME=root
MYSQL_ADMIN_PASSWORD=
MYSQL_DATABASE=collect_agent
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/collect_agent?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_TEST_URL=jdbc:mysql://127.0.0.1:3306/collect_agent_test?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
DASHSCOPE_API_KEY=

AGENT_LLM_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
